{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SGIIPP-IPSCANER",
  "version": "2.2.0",
  "identifier": "es.cis.ipscanner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SGIIPP-IPSCANER",
        "width": 1200,
        "height": 680,
        "minWidth": 900,
        "minHeight": 480
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
